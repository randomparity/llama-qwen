# Podman Quadlet unit for the llama.cpp Qwen3.8-27B server. This file is the
# source of truth for the served model configuration; `just start` only asks
# systemd to run it.
#
# `just install-service` expands the repository path below and writes the result
# to ~/.config/containers/systemd/. Edit this file and reinstall rather than
# editing the installed copy, which is overwritten on every install.

[Unit]
Description=llama.cpp server for Qwen3.8-27B
Documentation=https://github.com/randomparity/llama-qwen
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=llama-qwen
Image=ghcr.io/ggml-org/llama.cpp:server-cuda-b10423@sha256:a475c08c7c472425e3ebf7f6be9c6cb3a17e82ec28070ddeb22fffe3ca754a94
SecurityLabelDisable=true
AddDevice=nvidia.com/gpu=0
PublishPort=0.0.0.0:8001:8000
Volume=@REPO_DIR@/models:/models:ro,Z
Volume=@REPO_DIR@/templates:/templates:ro,Z
Exec=--model /models/Qwen3.8-27B-Q6_K.gguf \
     --alias qwen3.8-27b \
     --ctx-size 262144 \
     --parallel 1 \
     --n-gpu-layers 999 \
     --flash-attn on \
     --cache-type-k q8_0 \
     --cache-type-v q8_0 \
     --spec-type draft-mtp \
     --jinja \
     --chat-template-file /templates/qwen3.8-27b.jinja \
     --chat-template-kwargs '{"reasoning_effort":"xhigh"}' \
     --reasoning-format deepseek \
     --host 0.0.0.0 \
     --port 8000

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
